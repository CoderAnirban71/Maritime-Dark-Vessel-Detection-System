# Database (PostgreSQL with TimescaleDB)
DATABASE_URL=postgresql://samudra:samudra_dev_pw@localhost:5432/samudra_netra

# Redis Pub/Sub
REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL_AIS=layer1:ais
REDIS_CHANNEL_SPILL=layer1:spill
REDIS_CHANNEL_OCEAN=layer1:ocean
REDIS_CHANNEL_WIND=layer1:wind

# H3 Grid Resolution (8 = ~0.53km hex edge length)
H3_RESOLUTION=8

# Consumer Batch Settings
BATCH_MAX_SIZE=100
BATCH_MAX_WAIT_SECONDS=5.0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
